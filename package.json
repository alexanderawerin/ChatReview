{
  "name": "chatreview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Telegram chat recaps and roasts with optional photo slides",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src tests vite.config.js eslint.config.js --max-warnings=0",
    "format": "prettier --write src tests index.html package.json vite.config.js eslint.config.js",
    "format:check": "prettier --check src tests index.html package.json vite.config.js eslint.config.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 2,
    "printWidth": 100
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vite": "^7.3.6"
  }
}
